# Root env file consumed by docker-compose.yml only.
# Each service also has its own .env(.example) for running standalone
# without Docker (frontend/.env.example, backend/.env.example, ai-service/.env.example).

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
