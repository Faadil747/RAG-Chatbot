PORT=8000

# LLM_PROVIDER is the primary provider core/llm_client.py uses: "runpod",
# "deepseek", or "groq". If a call to it fails outright (connection error,
# timeout, non-2xx), it's retried once against LLM_FALLBACK_PROVIDER.
LLM_PROVIDER=runpod
LLM_FALLBACK_PROVIDER=deepseek

# "runpod": a self-hosted Ollama instance reached via a RunPod proxy, called
# through Ollama's OpenAI-compatible /v1 routes. No real API key needed --
# Ollama doesn't check it, but the OpenAI SDK requires a non-empty string.
RUNPOD_BASE_URL=https://your-runpod-proxy-host/v1
RUNPOD_MODEL=qwen2.5:14b
RUNPOD_API_KEY=ollama

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Model name depends on what your DeepSeek account/key exposes -- if you get
# a 400 "supported API model names are ..." error, use one of the names it lists.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=./data
CORS_ORIGIN=http://localhost:4000
